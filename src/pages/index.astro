---
import Event from '../components/Event.astro'
import Hero from '../components/Hero.astro'
import LatestPosts from '../components/LatestPosts.astro'
import Sponsors from '../components/Sponsors.astro'
import { Conferences } from '../data/data'
import Layout from '../layouts/Layout.astro'
import MascotPeek from '../components/MascotPeek.astro'
import { FEATURES } from '../features'
---

<Layout title="CloudNative Days" description="CloudNative Days はコミュニティ、企業、技術者が一堂に会し、クラウドネイティブムーブメントを牽引することを目的としたテックカンファレンスです。" ogImage="/favicon.svg" isTopPage={true}>
  <main>
    <Hero title="CloudNative Days Winter 2026" logo="/images/assets/cndw2026.png">
      <div class="max-w-4xl mx-auto">
        <p class="text-3xl md:text-4xl text-gray-800 font-serif italic font-bold">
          Scaling Together
        </p>
        <div class="mt-10 flex flex-col items-center gap-4">
          <p class="text-2xl md:text-3xl text-black font-bold flex items-center gap-3">
            <span class="text-3xl">📅</span>
            2026年11月18日(水)・19日(木)
          </p>
          <p class="text-xl md:text-2xl text-black font-bold flex items-center gap-3">
            <span class="text-3xl">📍</span>
            有明セントラルタワーホール&カンファレンス
          </p>
          <p class="text-lg md:text-xl text-gray-700 font-medium">
            現地 + オンライン配信のハイブリッド開催
          </p>
        </div>
        <p class="mt-12 text-xl text-black leading-relaxed">
          CloudNative Days はコミュニティ、企業、技術者が一堂に会し、クラウドネイティブムーブメントを牽引することを目的としたテックカンファレンスです。
        </p>
      </div>
    </Hero>

    <section class="pt-24">
      <div class="container mx-auto px-4 text-center flex flex-wrap justify-center gap-6">
        <a
          href="https://pfem.notion.site/CloudNative-Days-Winter-2026-2ae21b0141e083d0ab1981119d982d66"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-12 py-6 bg-indigo-600 text-white text-xl md:text-2xl font-bold rounded-xl hover:bg-indigo-700 hover:scale-105 transition-all duration-300 shadow-lg"
        >
          スポンサー募集中！
        </a>
        <a
          href="/cndw2026/cfp"
          class="inline-flex flex-col items-center justify-center px-12 py-5 bg-rose-600 text-white text-xl md:text-2xl font-bold rounded-xl hover:bg-rose-700 hover:scale-105 transition-all duration-300 shadow-lg"
        >
          <span>CFP募集中！</span>
          <span class="mt-1 text-sm md:text-base font-semibold">
            応募はこちら！9/21（月）締切
          </span>
        </a>
        <a
          href="https://pfem.notion.site/dfe21b0141e082fa9e6181e85070f3b5?pvs=105"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-12 py-6 bg-indigo-600 text-white text-xl md:text-2xl font-bold rounded-xl hover:bg-indigo-700 hover:scale-105 transition-all duration-300 shadow-lg"
        >
          お問い合わせ
        </a>
      </div>
    </section>

    <LatestPosts />

    {FEATURES.sponsors && <Sponsors />}


    <section class="py-24 ">
      <div class="container mx-auto px-4">
        <h2 class="text-black relative px-4 text-4xl font-bold mb-16 text-center">
          過去のイベント
        </h2>
        <div class="relative">
          <div class="flex flex-col gap-20">
            {
              Conferences?.filter(
                (conference) => conference.status == 'archived' || conference.status == 'migrated',
              )
                .sort((first, second) => second.id - first.id)
                .map((conference, index) => {
                  const url = `/${conference.abbr}`
                  const eventDays = conference.conferenceDays
                    .filter((day) => !day.internal)
                    .map((day) => day.date)
                    .join(',')
                  return (
                    <a href={url} class="block group">
                      <Event
                        name={conference.name}
                        days={eventDays}
                        img={conference.image}
                        theme={conference.theme}
                        about={conference.about}
                        align={index % 2 === 0 ? 'left' : 'right'}
                      />
                    </a>
                  )
                })
            }
          </div>
        </div>
        <div class="mt-12 text-center">
          <a href="/history" class="inline-block px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 hover:scale-105 transition-all duration-300">
            CloudNative Daysの歩みを見る
          </a>
        </div>
      </div>
    </section>

    <!-- マスコットのひょっこり -->
    <a href="/mascots">
      <MascotPeek character="suu" position="left" />
    </a>
    <a href="/mascots">
      <MascotPeek character="toge" position="right" />
    </a>
  </main>
</Layout>
