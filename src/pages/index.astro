---
import Hero from '../components/Hero.astro'
import Highlights from '../components/Highlights.astro'
import LatestPosts from '../components/LatestPosts.astro'
import MascotPeek from '../components/MascotPeek.astro'
import Sponsors from '../components/Sponsors.astro'
import Staff from '../components/Staff.astro'
import { FEATURES } from '../features'
import Layout from '../layouts/Layout.astro'
import MascotPeek from '../components/MascotPeek.astro'
import { FEATURES } from '../features'
import { PUBLIC_SITE_TITLE } from '../server-constants'

const siteUrl = Astro.site?.toString()
const organizer = {
  '@type': 'Organization',
  name: 'CloudNative Days 実行委員会',
  url: siteUrl,
}
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: PUBLIC_SITE_TITLE,
    alternateName: ['CNDW', 'CNDW2026'],
    url: siteUrl,
    inLanguage: 'ja',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: 'CloudNative Days Winter 2026',
    alternateName: ['CNDW2026', 'CNDW'],
    description: 'Scaling Together をテーマに、クラウドネイティブに取り組むエンジニアが集うテックカンファレンス。',
    url: siteUrl,
    startDate: '2026-11-18',
    endDate: '2026-11-19',
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
    location: [
      {
        '@type': 'Place',
        name: '有明セントラルタワーホール&カンファレンス',
        address: {
          '@type': 'PostalAddress',
          addressRegion: '東京都',
          addressLocality: '江東区',
          addressCountry: 'JP',
        },
      },
      { '@type': 'VirtualLocation', url: siteUrl },
    ],
    organizer,
  },
]
---

<Layout title="CloudNative Days Winter 2026 #CNDW2026 | 2026年11月18日〜19日 有明" description="CloudNative Days Winter 2026（略称 CNDW2026、CNDW）は、コミュニティ、企業、技術者が一堂に会し、クラウドネイティブムーブメントを牽引することを目的としたテックカンファレンスです。2026年11月18日〜19日、有明セントラルタワーホール&カンファレンスとオンラインのハイブリッドで開催。" ogImage="/favicon.svg" isTopPage={true} jsonLd={jsonLd}>
  <main>
    <Hero title="CloudNative Days Winter 2026" logo="/images/assets/cndw2026.png">
      <div class="max-w-4xl mx-auto">
        <p class="text-3xl md:text-4xl text-gray-800 font-serif italic font-bold">
          Scaling Together
        </p>
        <div class="mt-10 flex flex-col items-center gap-4">
          <p class="text-2xl md:text-3xl text-black font-bold flex items-center gap-3">
            <span class="text-3xl">📅</span>
            2026年11月18日(水)・19日(木)
          </p>
          <p class="text-xl md:text-2xl text-black font-bold flex items-center gap-3">
            <span class="text-3xl">📍</span>
            有明セントラルタワーホール&カンファレンス
          </p>
          <p class="text-lg md:text-xl text-gray-700 font-medium">
            現地 + オンライン配信のハイブリッド開催
          </p>
        </div>
        <p class="mt-12 text-xl text-black leading-relaxed">
          CloudNative Days はコミュニティ、企業、技術者が一堂に会し、クラウドネイティブムーブメントを牽引することを目的としたテックカンファレンスです。
        </p>
      </div>
    </Hero>

    <section class="pt-24">
      <div class="container mx-auto px-4 text-center">
        <div class="flex flex-col items-center gap-3">
          <a
            href="https://event.cloudnativedays.jp/cndw2026/registration"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 md:px-16 py-6 md:py-8 bg-orange-500 text-white text-xl md:text-3xl font-bold rounded-xl hover:bg-orange-600 hover:scale-105 transition-all duration-300 shadow-lg"
          >
            CNDW2026への申し込みはこちら！
          </a>
          <p class="text-sm text-gray-700">
            参加登録済みの場合、参加者ダッシュボードへ遷移します
          </p>
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-6">
          <a
            href="https://pfem.notion.site/CloudNative-Days-Winter-2026-2ae21b0141e083d0ab1981119d982d66"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-12 py-6 bg-indigo-600 text-white text-xl md:text-2xl font-bold rounded-xl hover:bg-indigo-700 hover:scale-105 transition-all duration-300 shadow-lg"
          >
            スポンサー募集中！
          </a>
          <a
            href="https://pfem.notion.site/dfe21b0141e082fa9e6181e85070f3b5?pvs=105"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-12 py-6 bg-indigo-600 text-white text-xl md:text-2xl font-bold rounded-xl hover:bg-indigo-700 hover:scale-105 transition-all duration-300 shadow-lg"
          >
            お問い合わせ
          </a>
        </div>
      </div>
    </section>

    <Highlights />

    <LatestPosts />

    {FEATURES.sponsors && <Sponsors />}

    <Staff />

    <!-- マスコットのひょっこり -->
    <a href="/mascots">
      <MascotPeek character="suu" position="left" />
    </a>
    <a href="/mascots">
      <MascotPeek character="toge" position="right" />
    </a>
  </main>
</Layout>
