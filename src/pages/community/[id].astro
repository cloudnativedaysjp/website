---
// Partner community detail. Ported from kaigi.cloudnativedays.jp
// (src/pages/community/[id].astro), stripped of the Prairie card visuals,
// BudouX and the Notion-backed "紹介ブログ" link (this site's Notion blog DB
// has no communityId property). Restyled to the current site idiom.
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { FEATURES } from '../../features'
import Layout from '../../layouts/Layout.astro'
import {
  communityTypeOrder,
  communityTypeLabel,
  getCommunityData,
  getCommunityLogo,
  type Community,
  type CommunityType,
} from '../../lib/community'

export function getStaticPaths() {
  if (!FEATURES.community) return []

  const communityData = getCommunityData()
  return communityTypeOrder.flatMap((type) =>
    communityData[type].map((community) => ({
      params: { id: community.id },
      props: { community, type },
    })),
  )
}

interface Props {
  community: Community
  type: CommunityType
}

const { community, type } = Astro.props
const logo = getCommunityLogo(community.logo)
const description = community.description.split('\n')[0]
const title = `${community.name} | 連携コミュニティ | CloudNative Days`

const siteOrigin = Astro.site?.origin ?? 'https://cloudnativedays.jp'
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '連携コミュニティ一覧',
      item: `${siteOrigin}/community`,
    },
    { '@type': 'ListItem', position: 2, name: community.name },
  ],
}
---

<Layout title={title} description={description} ogImage="/favicon.svg">
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <main class="pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
      <nav class="mb-6">
        <a
          href="/community"
          class="inline-flex items-center gap-2 text-gray-600 hover:text-indigo-600 transition-colors"
        >
          <Icon name="tabler:arrow-left" class="w-5 h-5" />
          <span>連携コミュニティ一覧に戻る</span>
        </a>
      </nav>

      <div
        class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-100 p-6 md:p-10"
      >
        <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
          {
            logo && (
              <div class="w-40 h-40 shrink-0 flex items-center justify-center bg-white p-4 rounded-xl border border-gray-100">
                <Image
                  src={logo}
                  alt={`${community.name} ロゴ`}
                  class="max-w-full max-h-full object-contain"
                />
              </div>
            )
          }
          <div class="w-full min-w-0">
            <span
              class="inline-block px-2 py-0.5 mb-3 text-xs font-bold bg-indigo-600 text-white rounded"
            >
              {communityTypeLabel[type]}
            </span>
            <h1
              class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 pb-4 border-b border-gray-100"
            >
              {community.name}
            </h1>
            <p class="text-gray-800 leading-relaxed whitespace-pre-line break-words">
              {community.description}
            </p>
            {
              community.url && (
                <a
                  href={community.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 mt-6 px-4 py-2 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors"
                >
                  <span>コミュニティサイトを見る</span>
                  <Icon name="tabler:external-link" class="w-4 h-4" />
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
