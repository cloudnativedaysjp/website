---
// Session list. Ported from kaigi.cloudnativedays.jp
// (src/pages/sessions/index.astro), adapted to the single-conference model:
// kaigi's conference filter (cndays/pek/sre/sponsor) collapses into a simple
// sponsor-vs-CFP category filter here, and day filter buttons are generated
// from timetable-config's `days` array instead of being hardcoded. Restyled
// to the current site idiom (white/backdrop-blur cards, indigo accent)
// instead of kaigi's washi/sumi palette. Uses a rest param ([...index]) so it
// matches exactly '/sessions' while still participating in FEATURES-gated
// static path generation, matching /timetable/[...index].astro.
import { Icon } from 'astro-icon/components'
import SessionCard from '../../components/SessionCard.astro'
import { FEATURES } from '../../features'
import Layout from '../../layouts/Layout.astro'
import { getTimetableData } from '../../lib/dreamkast/timetable'
import { days } from '../../lib/dreamkast/timetable-config'

export function getStaticPaths() {
  return FEATURES.sessions ? [{ params: { index: undefined } }] : []
}

const timetables = await getTimetableData()

const allTalks = timetables.flatMap((timetable) =>
  timetable.slots.flatMap((slot) => (slot.kind === 'talks' ? slot.talks : [])),
)
---

<Layout
  title="セッション一覧 | CloudNative Days Winter 2026"
  description="CloudNative Days Winter 2026のセッション一覧。日程・カテゴリで絞り込んで検索できます。"
>
  <main class="pt-24 pb-16 px-4">
    <div class="max-w-6xl mx-auto">
      <nav class="mb-8">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-gray-600 hover:text-indigo-600 transition-colors"
        >
          <Icon name="tabler:arrow-left" class="w-5 h-5" />
          <span>トップページに戻る</span>
        </a>
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold text-center text-black mb-8">
        セッション一覧
      </h1>

      <div class="mb-10 flex flex-col items-center gap-5">
        <!-- Day filters -->
        <div class="flex flex-wrap justify-center gap-0 border-b border-gray-200">
          <button
            data-filter="day"
            data-value="all"
            class="day-filter-btn filter-btn px-5 py-2 text-sm font-bold text-gray-900 border-b-2 border-blue-600 -mb-px transition-colors"
          >
            全日程
          </button>
          {
            days.map((d) => (
              <button
                data-filter="day"
                data-value={d.slug}
                class="day-filter-btn filter-btn px-5 py-2 text-sm font-bold text-gray-400 border-b-2 border-transparent -mb-px hover:text-gray-700 transition-colors"
              >
                {d.label}
              </button>
            ))
          }
        </div>

        <!-- Category filters -->
        <div class="flex flex-wrap justify-center items-center">
          <button
            data-filter="category"
            data-value="all"
            class="category-filter-btn filter-btn px-3 py-1 text-xs text-gray-900 font-bold transition-colors"
          >
            すべて
          </button>
          <span class="text-gray-300 text-xs select-none">｜</span>
          <button
            data-filter="category"
            data-value="cfp"
            class="category-filter-btn filter-btn px-3 py-1 text-xs text-gray-400 hover:text-gray-700 transition-colors"
          >
            公募セッション
          </button>
          <span class="text-gray-300 text-xs select-none">｜</span>
          <button
            data-filter="category"
            data-value="sponsor"
            class="category-filter-btn filter-btn px-3 py-1 text-xs text-gray-400 hover:text-gray-700 transition-colors"
          >
            スポンサーセッション
          </button>
        </div>
      </div>

      <div id="session-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          allTalks.map((talk) => (
            <SessionCard talk={talk} />
          ))
        }
      </div>
      <div id="no-results" class="hidden text-center py-12 text-gray-500">
        該当するセッションが見つかりませんでした。
      </div>
    </div>
  </main>
</Layout>

<script>
  function initFilters() {
    const urlParams = new URLSearchParams(window.location.search)
    let currentDayFilter = urlParams.get('day') || 'all'
    let currentCategoryFilter = urlParams.get('category') || 'all'

    const cards = document.querySelectorAll('.session-card')
    const noResults = document.getElementById('no-results')
    const filterBtns = document.querySelectorAll('.filter-btn')

    function applyFilters() {
      let visibleCount = 0

      cards.forEach((card) => {
        const htmlElement = card as HTMLElement
        const day = htmlElement.dataset.day
        const isSponsor = htmlElement.dataset.isSponsor === 'true'

        const matchDay = currentDayFilter === 'all' || currentDayFilter === day
        let matchCategory = false

        if (currentCategoryFilter === 'all') {
          matchCategory = true
        } else if (currentCategoryFilter === 'sponsor') {
          matchCategory = isSponsor
        } else {
          matchCategory = !isSponsor
        }

        if (matchDay && matchCategory) {
          htmlElement.style.display = ''
          visibleCount++
        } else {
          htmlElement.style.display = 'none'
        }
      })

      if (noResults instanceof HTMLElement) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none'
      }

      // Update URL without reloading
      const newUrl = new URL(window.location.href)
      if (currentDayFilter === 'all') newUrl.searchParams.delete('day')
      else newUrl.searchParams.set('day', currentDayFilter)

      if (currentCategoryFilter === 'all') newUrl.searchParams.delete('category')
      else newUrl.searchParams.set('category', currentCategoryFilter)

      window.history.replaceState({}, '', newUrl)

      // Update active button styles
      filterBtns.forEach((btn) => {
        const htmlBtn = btn as HTMLElement
        const filterType = htmlBtn.dataset.filter
        const value = htmlBtn.dataset.value
        const isActive =
          (filterType === 'day' && value === currentDayFilter) ||
          (filterType === 'category' && value === currentCategoryFilter)

        const isDay = filterType === 'day'

        if (isDay) {
          if (isActive) {
            htmlBtn.classList.remove('text-gray-400', 'border-transparent', 'hover:text-gray-700')
            htmlBtn.classList.add('text-gray-900', 'border-blue-600')
          } else {
            htmlBtn.classList.remove('text-gray-900', 'border-blue-600')
            htmlBtn.classList.add('text-gray-400', 'border-transparent', 'hover:text-gray-700')
          }
        } else {
          if (isActive) {
            htmlBtn.classList.remove('text-gray-400', 'hover:text-gray-700')
            htmlBtn.classList.add('text-gray-900', 'font-bold')
          } else {
            htmlBtn.classList.remove('text-gray-900', 'font-bold')
            htmlBtn.classList.add('text-gray-400', 'hover:text-gray-700')
          }
        }
      })
    }

    // Set initial active states
    applyFilters()

    // Add event listeners to buttons
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const htmlBtn = e.currentTarget as HTMLElement
        const filterType = htmlBtn.dataset.filter
        const value = htmlBtn.dataset.value

        if (filterType === 'day') {
          currentDayFilter = value || 'all'
        } else if (filterType === 'category') {
          currentCategoryFilter = value || 'all'
        }

        applyFilters()
      })
    })
  }

  // Run on initial load and view transitions
  initFilters()
  document.addEventListener('astro:after-swap', initFilters)
</script>
