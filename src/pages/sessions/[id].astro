---
// Session detail. Ported from kaigi.cloudnativedays.jp
// (src/pages/sessions/[id].astro), stripped of the multi-conference track
// color mapping (CNDW2026 is a single conference), the hls.js archive player
// and the session OG image lookup (no session-ogp-ids.json here — DEFERRED,
// see plan Phase 4) — OG image falls back to the site default, same as
// /timetable/[day].astro. Restyled to the current site idiom instead of
// kaigi's washi/sumi palette.
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Layout from '../../layouts/Layout.astro'
import { FEATURES } from '../../features'
import { days, trackRoomMap } from '../../lib/dreamkast/timetable-config'
import { getTimetableData } from '../../lib/dreamkast/timetable'
import { getSpeakerAvatar } from '../../lib/dreamkast/assets'
import type { TimetableTalk } from '../../lib/dreamkast/schema'

interface TalkWithContext extends TimetableTalk {
  daySlug: string
  dayLabel: string
  room: string
}

export async function getStaticPaths() {
  if (!FEATURES.sessions) return []

  const timetables = await getTimetableData()
  const allTalks: TalkWithContext[] = timetables.flatMap((timetable, i) =>
    timetable.slots.flatMap((slot) =>
      slot.kind === 'talks'
        ? slot.talks.map((talk) => ({
            ...talk,
            daySlug: days[i].slug,
            dayLabel: days[i].label,
            room: trackRoomMap[talk.trackName] ?? talk.trackName,
          }))
        : [],
    ),
  )

  return allTalks.map((talk) => ({
    params: { id: talk.id.toString() },
    props: { talk },
  }))
}

const { talk } = Astro.props as { talk: TalkWithContext }

const normalizedAbstract = talk.abstract.replace(/\s+/g, ' ').trim()
const description = normalizedAbstract
  ? normalizedAbstract.length > 160
    ? normalizedAbstract.slice(0, 160) + '…'
    : normalizedAbstract
  : `${talk.title}のセッション詳細ページです。`

const siteOrigin = Astro.site?.origin ?? 'https://cloudnativedays.jp'

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'セッション一覧',
      item: `${siteOrigin}/sessions`,
    },
    { '@type': 'ListItem', position: 2, name: talk.title },
  ],
}

// TODO(CNDW2026): 会場名が未確定のためトラックの部屋名を仮のlocationとして使用。
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: talk.title,
  startDate: `${talk.conferenceDayDate}T${talk.startTime.split('T')[1]}`,
  endDate: talk.endTime ? `${talk.conferenceDayDate}T${talk.endTime.split('T')[1]}` : undefined,
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: talk.room },
  description,
  performer: talk.speakers.map((s) => ({ '@type': 'Person', name: s.name })),
  organizer: { '@type': 'Organization', name: 'CloudNative Days実行委員会', url: siteOrigin },
  superEvent: { '@type': 'Event', name: 'CloudNative Days Winter 2026' },
}
---

<Layout
  title={`${talk.title} | CloudNative Days Winter 2026`}
  description={description}
  ogImage="/favicon.svg"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <main class="pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
      <nav class="mb-6">
        <a
          href="/sessions"
          class="inline-flex items-center gap-2 text-gray-600 hover:text-indigo-600 transition-colors"
        >
          <Icon name="tabler:arrow-left" class="w-5 h-5" />
          <span>セッション一覧に戻る</span>
        </a>
      </nav>

      <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-100 p-6 md:p-10">
        <div class="mb-4">
          <div class="text-gray-600 text-sm font-bold mb-3 flex flex-wrap gap-4">
            <span>
              {talk.dayLabel} {talk.startTime.substring(11, 16)} - {talk.endTime.substring(11, 16)}
            </span>
            <span>{talk.trackName}（{talk.room}）</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {
              talk.sponsorName ? (
                <span class="px-2 py-0.5 text-xs font-bold bg-amber-500 text-white rounded">
                  スポンサー
                </span>
              ) : (
                <span class="px-2 py-0.5 text-xs font-bold bg-indigo-600 text-white rounded">
                  公募
                </span>
              )
            }
            {
              talk.isKeynote && (
                <span class="px-2 py-0.5 text-xs font-bold border border-indigo-600 text-indigo-600 rounded">
                  キーノート
                </span>
              )
            }
            {
              talk.category && (
                <span class="px-2 py-0.5 text-xs font-medium bg-indigo-50 text-indigo-700 rounded">
                  {talk.category}
                </span>
              )
            }
            {
              talk.difficulty && (
                <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 rounded">
                  {talk.difficulty}
                </span>
              )
            }
          </div>
        </div>

        <h1 class="text-2xl md:text-4xl font-bold mb-6 leading-tight text-gray-900">
          {talk.title}
        </h1>

        {
          talk.sponsorName && (
            <div class="mb-6 inline-block px-4 py-2 bg-amber-50 border border-amber-200 text-sm text-amber-800 rounded-lg">
              提供: {talk.sponsorName}
            </div>
          )
        }

        <div class="prose max-w-none mb-10 text-gray-800 whitespace-pre-wrap">
          {talk.abstract || '説明がありません。'}
        </div>

        <h2 class="text-xl font-bold mb-6 border-b border-gray-200 pb-2 text-gray-900">
          スピーカー
        </h2>
        <div class:list={['grid grid-cols-1 gap-6', talk.speakers.length > 1 && 'md:grid-cols-2']}>
          {
            talk.speakers.map((speaker) => {
              const avatar = speaker.localAssetPath
                ? getSpeakerAvatar(speaker.localAssetPath)
                : undefined
              return (
                <div class="flex flex-col gap-4 p-4 bg-gray-50 rounded-xl">
                  <div class="flex items-start gap-4">
                    {avatar ? (
                      <Image
                        src={avatar}
                        alt={speaker.name}
                        width={80}
                        height={80}
                        format="webp"
                        class="w-20 h-20 rounded-full object-cover shrink-0 ring-1 ring-gray-100"
                      />
                    ) : (
                      <div class="w-20 h-20 rounded-full bg-gray-200 flex items-center justify-center shrink-0">
                        <Icon name="tabler:user" class="w-10 h-10 text-gray-400" />
                      </div>
                    )}
                    <div>
                      <div class="text-lg font-bold mb-1 text-gray-900">{speaker.name}</div>
                      <div class="text-sm text-gray-600 mb-2">
                        {speaker.company}
                        {speaker.jobTitle && <span class="ml-2">{speaker.jobTitle}</span>}
                      </div>
                      <div class="flex items-center gap-3">
                        {speaker.githubId && (
                          <a
                            href={`https://github.com/${speaker.githubId}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-1 text-xs text-gray-600 hover:text-indigo-600 transition-colors"
                            aria-label={`GitHub: ${speaker.githubId}`}
                          >
                            <Icon name="tabler:brand-github" class="w-4 h-4" />
                            <span>{speaker.githubId}</span>
                          </a>
                        )}
                        {speaker.twitterId && (
                          <a
                            href={`https://x.com/${speaker.twitterId}`}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-1 text-xs text-gray-600 hover:text-indigo-600 transition-colors"
                            aria-label={`X: ${speaker.twitterId}`}
                          >
                            <Icon name="tabler:brand-x" class="w-4 h-4" />
                            <span>{speaker.twitterId}</span>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                  {speaker.profile && (
                    <div class="text-sm text-gray-800 whitespace-pre-wrap leading-relaxed">
                      {speaker.profile}
                    </div>
                  )}
                </div>
              )
            })
          }
        </div>
      </div>
    </div>
  </main>
</Layout>
