---
import BlogCard from '../../components/BlogCard.astro'
import BlogPostsLink from '../../components/BlogPostsLink.astro'
import BlogTagsLink from '../../components/BlogTagsLink.astro'
import Headline from '../../components/Headline.astro'
import MascotPeek from '../../components/MascotPeek.astro'
import NoContents from '../../components/NoContents.astro'
import Layout from '../../layouts/Layout.astro'
import { getAllPosts, getRankedPosts, getAllTags } from '../../lib/notion/client'

const [posts, rankedPosts, tags] = await Promise.all([
  getAllPosts(),
  getRankedPosts(),
  getAllTags(),
])
---

<Layout
  title="CloudNative Days Blog"
  description="CloudNative Days実行委員会によるブログ"
  ogImage=""
>
  <Headline title="Blog" showMascots={true}>
    <p class="mt-4 text-lg text-black">
      CloudNative Days実行委員会によるブログ
    </p>
  </Headline>
  <div class="px-4 md:px-8 flex flex-col lg:flex-row gap-6 max-w-7xl mx-auto">
    <main class="flex-1">
      <div class="mb-6">
        <label for="blog-search" class="sr-only">記事を検索</label>
        <input
          id="blog-search"
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="記事を検索…"
          class="w-full border-b border-gray-200 bg-transparent py-2 text-base text-gray-900 outline-none transition-colors placeholder:text-gray-400 focus:border-blue-600"
        />
        <p id="blog-search-status" class="mt-2 text-sm text-gray-500">
          {posts.length}件の記事
        </p>
      </div>
      {
        posts.length === 0 ? (
          <NoContents contents={posts} />
        ) : (
          <ul id="blog-post-list" class="space-y-6">
            {posts.map((post) => (
              <li class="blog-post-item" data-slug={post.Slug}>
                <BlogCard post={post} />
              </li>
            ))}
          </ul>
        )
      }
      <p id="blog-no-results" class="hidden py-12 text-center text-gray-500">
        該当する記事が見つかりませんでした。
      </p>
    </main>

    <aside class="lg:w-80 flex-shrink-0">
      <div class="bg-white/80 backdrop-blur-sm rounded-xl p-6 sticky top-24">
        <BlogPostsLink heading="Recommended" posts={rankedPosts} />
        <BlogTagsLink heading="Categories" tags={tags} />
      </div>
    </aside>
  </div>

  <!-- マスコットのひょっこり -->
  <a href="/mascots">
    <MascotPeek character="suu" position="left" />
  </a>
  <a href="/mascots">
    <MascotPeek character="toge" position="right" />
  </a>
</Layout>

<script>
  import MiniSearch from 'minisearch'
  import { tokenize, type BlogSearchDocument } from '../../lib/search-utils'

  function initBlogSearch() {
    const input = document.getElementById('blog-search') as HTMLInputElement | null
    const status = document.getElementById('blog-search-status')
    const noResults = document.getElementById('blog-no-results')
    const items = Array.from(
      document.querySelectorAll<HTMLLIElement>('.blog-post-item'),
    )
    if (!input || items.length === 0) return

    const totalCount = items.length
    const defaultOrder = new Map(items.map((item, index) => [item.dataset.slug ?? '', index]))
    const searchParams = new URLSearchParams(window.location.search)
    const initialQuery = searchParams.get('q') ?? ''
    let miniSearch: MiniSearch<BlogSearchDocument> | null = null
    let indexReady = false

    async function loadIndex() {
      if (indexReady) return

      if (status) {
        status.textContent = '検索インデックスを読み込み中…'
      }

      const response = await fetch('/posts/search-index.json')
      if (!response.ok) {
        if (status) {
          status.textContent = '検索インデックスを読み込めませんでした。'
        }
        return
      }

      const payload = await response.json()
      miniSearch = new MiniSearch({
        idField: 'slug',
        fields: ['title', 'description', 'content'],
        storeFields: ['slug', 'title', 'description', 'pubDate'],
        tokenize,
        searchOptions: {
          boost: {
            title: 3,
            description: 2,
            content: 1,
          },
        },
      })

      miniSearch.addAll(payload)
      indexReady = true
    }

    function updateUrl(query: string) {
      const nextUrl = new URL(window.location.href)
      if (query) nextUrl.searchParams.set('q', query)
      else nextUrl.searchParams.delete('q')
      window.history.replaceState({}, '', nextUrl)
    }

    function resetOrder() {
      for (const item of items) {
        item.hidden = false
        item.style.order = String(defaultOrder.get(item.dataset.slug ?? '') ?? 0)
      }
    }

    function applySearch(query: string) {
      if (!indexReady || !miniSearch) return

      const normalizedQuery = query.trim()

      updateUrl(normalizedQuery)

      if (!normalizedQuery) {
        resetOrder()
        if (status) status.textContent = `${totalCount}件の記事`
        if (noResults) noResults.classList.add('hidden')
        return
      }

      const ranked = miniSearch.search(normalizedQuery)
      const visibleSlugs = new Set(ranked.map((doc) => doc.slug))
      const resultOrder = new Map(ranked.map((doc, index) => [doc.slug, index]))

      for (const item of items) {
        const slug = item.dataset.slug ?? ''
        const shouldShow = visibleSlugs.has(slug)
        item.hidden = !shouldShow
        item.style.order = shouldShow
          ? String(resultOrder.get(slug) ?? 0)
          : String(items.length + 1)
      }

      if (status) {
        status.textContent = `${ranked.length}件ヒット`
      }
      if (noResults) {
        noResults.classList.toggle('hidden', ranked.length !== 0)
      }
    }

    input.value = initialQuery
    input.addEventListener('input', () => applySearch(input.value))

    loadIndex().then(() => applySearch(input.value))
  }

  initBlogSearch()
  document.addEventListener('astro:after-swap', initBlogSearch)
</script>
