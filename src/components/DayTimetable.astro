---
// Grid structure ported from kaigi.cloudnativedays.jp
// (src/components/DayTimetable.astro): 100px time column + 1fr per track on
// desktop, stacked-by-time on mobile. Visual design restyled to the current
// site idiom (white/backdrop-blur cards, indigo accent) instead of kaigi's
// washi/sumi palette.
import type { DayTimetable } from '../lib/dreamkast/schema'
import TimetableTalkCard from './TimetableTalkCard.astro'

export interface Props {
  timetable: DayTimetable
}

const { timetable } = Astro.props
const { tracks, slots } = timetable
const trackCount = tracks.length
---

<div class="border border-gray-200 rounded-2xl overflow-hidden bg-white/80 backdrop-blur-sm">
  <!-- Desktop Header -->
  <div
    class="hidden lg:grid border-b border-gray-200"
    style={`grid-template-columns: 100px repeat(${trackCount}, 1fr);`}
  >
    <div class="bg-indigo-600 p-2 border-r border-indigo-500"></div>
    {
      tracks.map((track) => (
        <div class="p-3 text-center border-l border-indigo-500 bg-indigo-600 text-white">
          <p class="font-bold text-sm lg:text-lg">{track.name}</p>
          <p class="text-xs text-indigo-100">{track.room}</p>
        </div>
      ))
    }
  </div>

  <!-- Slots -->
  <div class="flex flex-col">
    {
      slots.map((slot) => (
        <div
          class="flex flex-col border-b border-gray-100 last:border-b-0 lg:grid"
          style={`grid-template-columns: 100px repeat(${trackCount}, 1fr);`}
        >
          {/* Time indicator */}
          <div class="bg-gray-50 p-2 lg:p-3 flex items-center justify-center border-b border-gray-100 lg:border-b-0 lg:border-r border-gray-200">
            <span class="text-sm lg:text-base text-gray-600 font-mono font-bold whitespace-nowrap leading-tight text-center">
              {slot.startTime}
              <span class="text-xs lg:text-sm font-normal text-gray-400">
                <span class="hidden lg:inline">
                  <br />~<br />
                </span>
                <span class="inline lg:hidden"> ~ </span>
                {slot.endTime ?? ''}
              </span>
            </span>
          </div>

          <div class="flex flex-col lg:contents">
            {slot.kind === 'event' ? (
              <div
                class="bg-gray-100 text-gray-600 p-3 lg:p-4 flex items-center justify-center lg:border-l border-gray-200"
                style={`grid-column: span ${trackCount};`}
              >
                <p class="text-sm font-bold tracking-wide">{slot.label}</p>
              </div>
            ) : (
              tracks.map((track) => {
                const talk = slot.talks.find((t) => t.trackId === track.id)
                const isKeynoteEmpty = slot.type === 'keynote' && !talk
                return (
                  <div
                    class:list={[
                      'border-b last:border-b-0 lg:border-b-0 lg:border-l border-gray-100',
                      isKeynoteEmpty
                        ? 'bg-gray-50'
                        : 'relative p-2 bg-white/80 flex flex-col pt-3 lg:pt-2',
                    ]}
                  >
                    {talk ? (
                      <>
                        <div class="lg:hidden flex items-center mb-2 px-1">
                          <span class="text-xs text-gray-400">{track.name}</span>
                        </div>
                        <div class="grow">
                          <TimetableTalkCard talk={talk} />
                        </div>
                      </>
                    ) : !isKeynoteEmpty ? (
                      <>
                        <div class="lg:hidden flex items-center mb-2 px-1">
                          <span class="text-xs text-gray-400">{track.name}</span>
                        </div>
                        <div class="grow">
                          <div class="h-full min-h-16 flex items-center justify-center bg-gray-50">
                            <span class="text-xs text-gray-300">-</span>
                          </div>
                        </div>
                      </>
                    ) : null}
                  </div>
                )
              })
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>
