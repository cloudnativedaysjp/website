---
// Homepage sponsors section, tier-grouped. Structure ported from
// kaigi.cloudnativedays.jp's Sponsors.astro (tier grouping, per-tier logo
// size/card ladder, empty-data soft-hide) — visual design (washi palette,
// brush SVG headings, BudouX, torn-paper filters) intentionally dropped in
// favor of the existing site idiom (white/backdrop-blur cards, indigo accent).
import { Image } from 'astro:assets'
import { getSponsors } from '../lib/dreamkast/client'
import {
  groupSponsorsByType,
  getSponsorLogo,
  sponsorTypeAccent,
} from '../lib/dreamkast/assets'
import { sponsorTypeLabel, type SponsorType } from '../lib/dreamkast/schema'

const sponsors = await getSponsors()
const sponsorGroups = groupSponsorsByType(sponsors)

// Ladder: Diamond largest -> Logo/Media/Tool smallest.
const logoSizeClass: Record<SponsorType, string> = {
  Support: 'h-20 md:h-28',
  Diamond: 'h-20 md:h-28',
  Platinum: 'h-16 md:h-24',
  Gold: 'h-14 md:h-20',
  Booth: 'h-12 md:h-16',
  Party: 'h-10 md:h-14',
  CM: 'h-10 md:h-14',
  Logo: 'h-8 md:h-12',
  Media: 'h-8 md:h-12',
  Tool: 'h-8 md:h-12',
}

// Cards are fixed-width flex items (width = column share minus gap) inside a
// centered flex-wrap container, so a short last row stays centered instead of
// hugging the left edge like it would in a CSS grid. Gap is 1rem / md:1.5rem.
const cardWidthClass: Record<SponsorType, string> = {
  Support: 'w-full md:w-[calc(50%-0.75rem)]',
  Diamond: 'w-full md:w-[calc(50%-0.75rem)]',
  Platinum: 'w-[calc(50%-0.5rem)] md:w-[calc(33.333%-1rem)]',
  Gold: 'w-[calc(50%-0.5rem)] md:w-[calc(33.333%-1rem)]',
  Booth: 'w-[calc(50%-0.5rem)] md:w-[calc(25%-1.125rem)]',
  Party: 'w-[calc(50%-0.5rem)] md:w-[calc(25%-1.125rem)]',
  CM: 'w-[calc(50%-0.5rem)] md:w-[calc(25%-1.125rem)]',
  Logo: 'w-[calc(50%-0.5rem)] md:w-[calc(25%-1.125rem)] lg:w-[calc(16.666%-1.25rem)]',
  Media: 'w-[calc(50%-0.5rem)] md:w-[calc(25%-1.125rem)] lg:w-[calc(16.666%-1.25rem)]',
  Tool: 'w-[calc(50%-0.5rem)] md:w-[calc(25%-1.125rem)] lg:w-[calc(16.666%-1.25rem)]',
}
---

{sponsors.length > 0 && (
  <section id="sponsors" class="py-24">
    <div class="container mx-auto px-4">
      <h2 class="text-black relative px-4 text-4xl font-bold mb-16 text-center">
        スポンサー
      </h2>
      <div class="flex flex-col gap-16">
        {sponsorGroups.map(({ type, sponsors: typeSponsors }) => (
          <div>
            <div class="flex justify-center mb-8">
              <h3 class={`text-2xl font-bold text-center border-b-2 border-indigo-600 pb-2 ${sponsorTypeAccent[type]}`}>
                {sponsorTypeLabel[type]}
              </h3>
            </div>
            <div class="flex flex-wrap justify-center gap-4 md:gap-6">
              {typeSponsors.map((sponsor) => {
                const logo = getSponsorLogo(sponsor.localAssetPath)
                return (
                  <a
                    href={sponsor.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`${cardWidthClass[type]} bg-white/80 backdrop-blur-sm rounded-2xl shadow-sm hover:shadow-md transition-shadow duration-300 border border-gray-100 flex items-center justify-center p-6`}
                  >
                    {logo ? (
                      <Image
                        src={logo}
                        alt={sponsor.name}
                        class={`${logoSizeClass[type]} w-auto object-contain`}
                      />
                    ) : (
                      <span class="text-center text-gray-700 font-medium">
                        {sponsor.name}
                      </span>
                    )}
                  </a>
                )
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
