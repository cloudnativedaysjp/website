---
import { Image } from "astro:assets";
import { getStaffMembers } from "../lib/dreamkast/client";
import { getStaffImage } from "../lib/staff/assets";

const staffMembers = await getStaffMembers();
---

<section id="staff" class="py-24">
  <div class="container mx-auto px-4">
    <h2 class="text-black relative px-4 text-4xl font-bold mb-12 text-center">
      スタッフ
    </h2>
    <h3 class="text-2xl font-bold text-gray-700 mb-10 text-center">実行委員</h3>

    <div class="flex flex-wrap justify-center gap-6 md:gap-8">
      {
        staffMembers.map((staff) => {
          const image = staff.image ? getStaffImage(staff.image) : undefined;
          const Tag = staff.url ? "a" : "div";
          const linkProps = staff.url
            ? {
                href: staff.url,
                target: "_blank",
                rel: "noopener noreferrer",
              }
            : {};

          return (
            <Tag
              {...linkProps}
              aria-label={staff.name}
              title={staff.name}
              class="block h-20 w-20 overflow-hidden rounded-full border border-gray-200 bg-gray-100 shadow-md transition-all duration-300 hover:scale-105 hover:shadow-xl sm:h-24 sm:w-24 lg:h-28 lg:w-28"
            >
              {image && (
                <Image
                  src={image}
                  alt={staff.name}
                  width={112}
                  height={112}
                  format="webp"
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              )}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>
