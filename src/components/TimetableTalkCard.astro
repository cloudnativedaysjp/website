---
// Compact session card for the timetable grid. Ported from
// kaigi.cloudnativedays.jp's TalkCard.astro, stripped of the multi-conference
// color mapping (PEK/SRE/CNDays) since CNDW2026 is a single conference, and
// restyled to the current site idiom. Named TimetableTalkCard (rather than
// TalkCard) to avoid clashing with the existing src/components/Talk.astro,
// which renders past-event talks under src/types/talk.ts.
import { Image } from 'astro:assets'
import { FEATURES } from '../features'
import { getSpeakerAvatar } from '../lib/dreamkast/assets'
import type { TimetableTalk } from '../lib/dreamkast/schema'

export interface Props {
  talk: TimetableTalk
}

const { talk } = Astro.props

const isSponsor = !!talk.sponsorName
const isKeynote = !!talk.isKeynote

const cardClass = [
  'block h-full rounded-xl border-l-4 p-3 transition-colors overflow-hidden',
  isSponsor
    ? 'border-l-amber-500 bg-amber-50/80'
    : isKeynote
      ? 'border-l-indigo-600 bg-indigo-50/80'
      : 'border-l-indigo-300 bg-white/80 hover:bg-indigo-50/60',
].join(' ')

// Dynamic tag: links to /sessions/{id} only when the sessions feature is on
// (that page doesn't exist until Phase 4); otherwise renders as a plain,
// non-interactive card.
const Tag = FEATURES.sessions ? 'a' : 'div'
const linkProps = FEATURES.sessions ? { href: `/sessions/${talk.id}` } : {}
---

<Tag {...linkProps} class={cardClass}>
  <p class="text-xs lg:text-sm font-bold text-gray-900 leading-snug mb-2">
    {talk.title}
  </p>

  {talk.speakers.length > 0 && (
    <div class="flex flex-col gap-1.5 mb-2">
      {talk.speakers.map((speaker) => {
        const avatar = speaker.localAssetPath ? getSpeakerAvatar(speaker.localAssetPath) : undefined
        return (
          <div class="flex items-center gap-2">
            {avatar ? (
              <Image
                src={avatar}
                alt={speaker.name}
                width={32}
                height={32}
                format="webp"
                class="w-6 h-6 lg:w-8 lg:h-8 rounded-full object-cover shrink-0 ring-1 ring-gray-100"
                loading="lazy"
              />
            ) : (
              <div class="w-6 h-6 lg:w-8 lg:h-8 rounded-full bg-gray-100 shrink-0 flex items-center justify-center">
                <svg class="w-3 h-3 lg:w-4 lg:h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
            )}
            <div class="min-w-0">
              <p class="text-xs lg:text-sm font-medium text-gray-800 truncate">{speaker.name}</p>
            </div>
          </div>
        )
      })}
    </div>
  )}

  <div class="flex flex-wrap gap-1">
    {isSponsor && (
      <span class="inline-block text-[10px] lg:text-xs font-bold px-1.5 py-0.5 bg-amber-500 text-white rounded">
        スポンサー
      </span>
    )}
    {isKeynote && (
      <span class="inline-block text-[10px] lg:text-xs font-bold px-1.5 py-0.5 bg-indigo-600 text-white rounded">
        キーノート
      </span>
    )}
    {talk.difficulty && (
      <span class="inline-block text-[10px] lg:text-xs font-medium px-1.5 py-0.5 bg-gray-100 text-gray-700 border border-gray-200 rounded">
        {talk.difficulty}
      </span>
    )}
    {talk.category && (
      <span class="inline-block text-[10px] lg:text-xs font-medium px-1.5 py-0.5 bg-indigo-50 text-indigo-700 rounded">
        {talk.category}
      </span>
    )}
  </div>
</Tag>

