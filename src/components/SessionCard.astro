---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { FEATURES } from "../features";
import { getSpeakerAvatar } from "../lib/dreamkast/assets";
import type { TimetableTalk } from "../lib/dreamkast/schema";
import { days, trackRoomMap } from "../lib/dreamkast/timetable-config";

export interface Props {
  talk: TimetableTalk;
  headingTag?: "h2" | "h4";
}

const { talk, headingTag: Heading = "h2" } = Astro.props;
const day = days.find((day) => day.date === talk.conferenceDayDate);
const Tag = FEATURES.sessions ? "a" : "div";
const linkProps = FEATURES.sessions ? { href: `/sessions/${talk.id}` } : {};
---

<Tag
  {...linkProps}
  class="session-card group flex flex-col h-full bg-white/80 backdrop-blur-sm rounded-2xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 p-5"
  data-day={day?.slug}
  data-track={talk.trackName}
  data-is-sponsor={talk.sponsorName ? "true" : "false"}
  aria-label={`${talk.title}。スピーカー: ${talk.speakers.map((s) => s.name).join("、")}`}
>
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3"
    aria-hidden="true"
  >
    <span class="text-xs text-gray-500">
      {day?.label}
    </span>
    <span class="text-xs font-mono text-gray-500">
      {talk.startTime.substring(11, 16)} - {talk.endTime.substring(11, 16)}
    </span>
  </div>

  <div class="flex flex-wrap gap-1.5 mb-3" aria-hidden="true">
    {
      talk.sponsorName ? (
        <span class="px-2 py-0.5 text-xs font-bold bg-amber-500 text-white rounded">
          スポンサー
        </span>
      ) : (
        !talk.isKeynote && (
          <span class="px-2 py-0.5 text-xs font-bold bg-indigo-600 text-white rounded">
            公募
          </span>
        )
      )
    }
    {
      talk.isKeynote && (
        <span class="px-2 py-0.5 text-xs font-bold border border-indigo-600 text-indigo-600 rounded">
          キーノート
        </span>
      )
    }
    {
      talk.category && (
        <span class="px-2 py-0.5 text-xs font-medium bg-indigo-50 text-indigo-700 rounded">
          {talk.category}
        </span>
      )
    }
    {
      talk.difficulty && (
        <span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200 rounded">
          {talk.difficulty}
        </span>
      )
    }
  </div>

  <Heading
    class="text-base md:text-lg font-bold text-gray-900 leading-snug mb-2"
    aria-hidden="true"
  >
    {talk.title}
  </Heading>

  <p class="text-sm text-gray-600 line-clamp-3 mb-4">
    {talk.abstract || "説明がありません"}
  </p>

  <div
    class="flex flex-col gap-2 mt-auto pt-3 border-t border-gray-100 shrink-0"
  >
    {
      talk.speakers.map((speaker) => {
        const avatar = speaker.localAssetPath
          ? getSpeakerAvatar(speaker.localAssetPath)
          : undefined;
        return (
          <div class="flex items-center gap-2" aria-hidden="true">
            {avatar ? (
              <Image
                src={avatar}
                alt=""
                width={32}
                height={32}
                format="webp"
                loading="lazy"
                class="w-8 h-8 rounded-full object-cover shrink-0 ring-1 ring-gray-100"
              />
            ) : (
              <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                <Icon name="tabler:user" class="w-4 h-4 text-gray-400" />
              </div>
            )}
            <div class="min-w-0">
              <div class="text-sm font-medium text-gray-800 truncate">
                {speaker.name}
              </div>
              {speaker.company && (
                <div class="text-xs text-gray-500 truncate">
                  {speaker.company}
                </div>
              )}
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="mt-3 text-xs text-gray-400" aria-hidden="true">
    {trackRoomMap[talk.trackName] ?? talk.trackName}
  </div>
</Tag>
